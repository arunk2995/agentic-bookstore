# ============================================================
# Environment Variables for Agentic eCommerce Bookstore
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=bookstore123
POSTGRES_PORT=5432

# --- JWT Configuration ---
# Must be at least 256 bits (32 characters) for HS256
JWT_SECRET=bookstore-jwt-secret-change-in-production-must-be-256-bits
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=86400
JWT_ISSUER=agentic-bookstore

# --- Server ---
SERVER_PORT=8080

# --- Agentic AI ---
# Set AGENT_MOCK_MODE=false to use a real OpenAI-compatible provider
AGENT_MOCK_MODE=true
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com

# --- Payment Provider ---
# Set PAYMENT_MOCK_MODE=false for real payment integration
PAYMENT_MOCK_MODE=true
PAYMENT_PROVIDER_URL=https://your-payment-provider.example.com
PAYMENT_WEBHOOK_SECRET=your-webhook-secret-here

# --- Email Provider ---
EMAIL_MOCK_MODE=true
EMAIL_FROM=noreply@yourbookstore.com
EMAIL_FROM_NAME=Bookstore

# --- Shipping Provider ---
SHIPPING_MOCK_MODE=true
SHIPPING_PROVIDER_URL=https://your-shipping-provider.example.com

# --- Application Settings ---
LOW_STOCK_THRESHOLD=10
